# =====================================================================
#  ЧТО НЕ ПОПАДАЕТ В РЕПОЗИТОРИЙ
# =====================================================================
# ВАЖНО про .gitignore: он действует только на НЕОТСЛЕЖИВАЕМЫЕ файлы.
# Если файл уже в индексе, добавление строки сюда ничего не меняет — именно
# так в репозитории оказались 26 МБ data/events.jsonl и 12 МБ логов при том,
# что оба были перечислены ниже. Убирать нужно так:
#     git rm --cached <файл>
# а из ИСТОРИИ (репозиторий похудеет с 24 МБ до ~2 МБ) — так:
#     pip install git-filter-repo
#     git filter-repo --path data/events.jsonl --path simulator.log \
#                     --path simulator.log.1 --invert-paths
# Второе переписывает историю и требует push --force — делать осознанно.

# --- секреты ---------------------------------------------------------
.secret_key
.gitlab_token
# Токен и чат Telegram. Раньше токен был вписан ЛИТЕРАЛОМ в config.py — файл
# под git, — то есть живая учётная запись бота лежала в репозитории. Значение
# из истории необходимо отозвать у @BotFather.
.telegram_token
.telegram_chat
# конфигурация с боевым токеном; рядом лежит web_config.example.json
web_config.json

# --- состояние процесса ----------------------------------------------
.simся прогоном мира / make_demo.py) -----
data/
!data/.gitkeep

# --- логи -------------------------------------------------------------
logs/
simulator.log*_state.json
.sim_state.json.bak
.sim_state.json.tmp

# --- данные симуляции (генерируют

# --- рабочие выгрузки -------------------------------------------------
results/
reports/
demo/out/

# --- python -----------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# --- временные файлы Office и FUSE ------------------------------------
~$*
.fuse_hidden*

# =====================================================================
#  МОДЕЛЬ СЛОЯ L2 — НАМЕРЕННО ОТСЛЕЖИВАЕТСЯ
# =====================================================================
# models/runtime_model.json РАНЬШЕ был здесь, и это была ошибка: на свежем
# клоне детектор не находил модель, слой L2 молча выключался, и проверяющий
# видел систему без её ключевой части — при том что вся работа про ML.
#
# Файл маленький (около 60 КБ), полностью воспроизводим
# (research/train_runtime_model.py) и содержит метрики, по которым обучен, —
# то есть является ещё и артефактом эксперимента. Держим в репозитории.
#
# Промежуточные модели и эксперименты — не держим:
models/*.tmp.json
models/experiments/

# зависимости jsdom для тестов страниц — ставятся npm install
node_modules/
package-lock.json
