{
  "id": "container-api-creds",
  "technique": "T1552.007",
  "tactic": "Credential Access",
  "title": "Учётные данные реестра контейнеров в манифесте",
  "severity": "high",
  "risk": 0.7,
  "rationale": "Манифест k8s/registry с длинным высокоэнтропийным токеном.",
  "when": {
    "action": "push",
    "path": {
      "contains_any": [
        "k8s/",
        "kubernetes/",
        "registry",
        "imagepull"
      ]
    },
    "has_high_entropy_token": true,
    "placeholder_signal": false
  }
}